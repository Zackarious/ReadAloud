<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="ReadAloudWindow" parent="AdwApplicationWindow">
    <property name="default-width">700</property>
    <property name="default-height">700</property>
    <property name="title">ReadAloud</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="decoration-layout">:minimize,maximize,close</property>
            <child type="start">
              <object class="GtkButton" id="open_button">
                <property name="width-request">48</property>
                <property name="height-request">42</property>
                <property name="icon-name">im.zackarious.ReadAloud.folder-open</property>
                <property name="tooltip-text" translatable="yes">Open Text File</property>
                <property name="action-name">win.open</property>
                <style>
                  <class name="highlight-accent-btn"/>
                </style>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="wiki_button">
                <property name="width-request">48</property>
                <property name="height-request">42</property>
                <property name="tooltip-text" translatable="yes">Import from Wikipedia</property>
                <property name="action-name">win.import-wikipedia</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkButton" id="save_text_button">
                <property name="width-request">48</property>
                <property name="height-request">42</property>
                <property name="icon-name">im.zackarious.ReadAloud.disk</property>
                <property name="tooltip-text" translatable="yes">Save Text to File</property>
                <property name="action-name">win.save-as</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>

        <child type="top">
          <object class="GtkOverlay" id="tab_bar_overlay">
            <property name="child">
              <object class="AdwTabBar" id="tab_bar">
                <property name="view">tab_view</property>
                <property name="autohide">false</property>
                <property name="expand-tabs">false</property>
                <property name="end-action-widget">
                  <object class="GtkBox" id="tab_bar_end_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <property name="margin-end">2</property>
                    <child>
                      <object class="GtkBox" id="font_zoom_popup">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">2</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="font-zoom-tab-bar"/>
                        </style>
                        <child>
                          <object class="GtkButton" id="font_decrease_btn">
                            <property name="icon-name">list-remove-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Decrease Font Size (Ctrl -)</property>
                            <style>
                              <class name="flat"/>
                              <class name="circular"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="font_zoom_label">
                            <property name="label">130%</property>
                            <property name="tooltip-text" translatable="yes">Current Font Size</property>
                            <style>
                              <class name="caption"/>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="font_increase_btn">
                            <property name="icon-name">list-add-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Increase Font Size (Ctrl +)</property>
                            <style>
                              <class name="flat"/>
                              <class name="circular"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="new_tab_button">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="tooltip-text" translatable="yes">New Tab (Ctrl+T)</property>
                        <property name="action-name">win.new-tab</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkRevealer" id="tab_nav_prev_revealer">
                <property name="reveal-child">false</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">200</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="margin-start">6</property>
                <property name="child">
                  <object class="GtkButton" id="tab_nav_prev_btn">
                    <property name="icon-name">go-previous-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Previous Tab</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="tab-nav-btn"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkRevealer" id="tab_nav_next_revealer">
                <property name="reveal-child">false</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">200</property>
                <property name="halign">end</property>
                <property name="valign">center</property>
                <property name="margin-end">152</property>
                <property name="child">
                  <object class="GtkButton" id="tab_nav_next_btn">
                    <property name="icon-name">go-next-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Next Tab</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="tab-nav-btn"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <child type="bottom">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <property name="hexpand">true</property>

            <child>
              <object class="GtkRevealer" id="playback_toolbar_revealer">
                <property name="reveal-child">false</property>
                <property name="transition-type">slide-up</property>
                <property name="transition-duration">200</property>
                <property name="child">
                  <object class="GtkBox" id="playback_toolbar">
                    <property name="orientation">0</property>
                    <property name="halign">GTK_ALIGN_CENTER</property>
                    <property name="valign">GTK_ALIGN_CENTER</property>
                    <property name="spacing">8</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">4</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <style>
                      <class name="playback-popup-toolbar"/>
                    </style>

                    <child>
                      <object class="GtkButton" id="pause_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="icon-name">media-playback-pause-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Pause</property>
                        <property name="sensitive">false</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <style>
                          <class name="highlight-accent-btn"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="rewind_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="icon-name">im.zackarious.ReadAloud.rewind-15-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Rewind 15 seconds</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <signal name="clicked" handler="rewind_15s" swapped="no"/>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="forward_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="icon-name">im.zackarious.ReadAloud.forward-15-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Forward 15 seconds</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <signal name="clicked" handler="forward_15s" swapped="no"/>
                      </object>
                    </child>

                    <child>
                      <object class="GtkButton" id="stop_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="icon-name">media-playback-stop-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Stop</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <style>
                          <class name="highlight-accent-btn"/>
                        </style>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="bottom_fixed_bar">
                <property name="spacing">12</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="hexpand">true</property>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">0</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="halign">GTK_ALIGN_START</property>
                    <property name="spacing">6</property>

                    <child type="start">
                      <object class="GtkDropDown" id="lang_chooser">
                        <property name="enable-search">false</property>
                        <property name="tooltip-text" translatable="yes">Choose Language</property>
                        <property name="valign">center</property>
                        <signal name="notify::selected" handler="on_lang_changed"/>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>English</item>
                              <item>Esperanto</item>
                              <item>Deutsch</item>
                              <item>Italiano</item>
                              <item>Español</item>
                              <item>Francais</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkDropDown" id="voice_chooser">
                        <property name="enable-search">false</property>
                        <property name="tooltip-text" translatable="yes">Choose Voice</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox" id="speed_button">
                    <property name="orientation">0</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="halign">GTK_ALIGN_START</property>
                    <child>
                      <object class="GtkDropDown" id="speed_chooser">
                        <property name="enable-search">false</property>
                        <property name="tooltip-text" translatable="yes">Adjust Speed</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <property name="selected">2</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Slower</item>
                              <item>Slow</item>
                              <item>Normal</item>
                              <item>Fast</item>
                              <item>Super Fast</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">0</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">6</property>
                    <property name="halign">GTK_ALIGN_END</property>
                    <property name="hexpand">true</property>
                    <property name="spacing">6</property>

                    <child>
                      <object class="GtkButton" id="read_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="icon-name">media-playback-start-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Read Text</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                        <signal name="clicked" handler="read_text" swapped="no"/>
                        <style>
                          <class name="highlight-accent-btn"/>
                        </style>
                      </object>
                    </child>

                    <child type="end">
                      <object class="GtkButton" id="save_button">
                        <property name="width-request">48</property>
                        <property name="height-request">42</property>
                        <property name="tooltip-text" translatable="yes">Save Audio to File</property>
                        <property name="icon-name">im.zackarious.ReadAloud.cd</property>
                        <property name="valign">GTK_ALIGN_CENTER</property>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>

        <property name="content">
          <object class="GtkOverlay" id="editor_overlay">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="child">
              <object class="AdwTabView" id="tab_view">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkBox" id="drop_placeholder">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="orientation">vertical</property>
                <property name="spacing">14</property>
                <property name="can-target">true</property>
                <style>
                  <class name="drag-drop-card"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">document-open-symbolic</property>
                    <property name="pixel-size">64</property>
                    <style>
                      <class name="accent"/>
                      <class name="drag-drop-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Drag &amp; Drop Files Here</property>
                    <style>
                      <class name="title-2"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Drop .txt, .md, .pdf, or .epub files into ReadAloud to import them into tabs.

• Compatible with TXT, MD, PDF, and EPUB documents
• Extracts book chapters into separate tabs
• Strip brackets, pipes, hashes, or stars on import</property>
                    <property name="justify">center</property>
                    <property name="wrap">true</property>
                    <style>
                      <class name="body"/>
                      <class name="drag-drop-desc"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Or click anywhere and start typing to begin</property>
                    <style>
                      <class name="caption"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <submenu>
        <attribute name="label" translatable="yes">Tools</attribute>
        <section>
          <item>
            <attribute name="label" translatable="yes">Automatically Remove All Tags</attribute>
            <attribute name="action">win.auto-remove-tags</attribute>
          </item>
        </section>
        <section>
          <item>
            <attribute name="label" translatable="yes">Remove ( ) Brackets</attribute>
            <attribute name="action">win.remove-round-brackets</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">Remove [ ] Brackets</attribute>
            <attribute name="action">win.remove-square-brackets</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">Remove | Pipes</attribute>
            <attribute name="action">win.remove-pipe-brackets</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">Remove # Hashes</attribute>
            <attribute name="action">win.remove-hashes</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">Remove * Stars (Asterisks)</attribute>
            <attribute name="action">win.remove-stars</attribute>
          </item>
        </section>
        <section>
          <item>
            <attribute name="label" translatable="yes">Remove All</attribute>
            <attribute name="action">win.remove-all-tags</attribute>
          </item>
          <item>
            <attribute name="label" translatable="yes">_Unwrap / Reflow Text</attribute>
            <attribute name="action">win.unwrap-text</attribute>
          </item>
        </section>
        <section>
          <item>
            <attribute name="label" translatable="yes">Import Wikipedia Article…</attribute>
            <attribute name="action">win.import-wikipedia</attribute>
          </item>
        </section>
        <section>
          <submenu>
            <attribute name="label" translatable="yes">Preset Voice Demos</attribute>
            <item>
              <attribute name="label" translatable="yes">Demo 1 — English (UK) Jenny</attribute>
              <attribute name="action">win.load-demo</attribute>
              <attribute name="target">demo_1</attribute>
            </item>
            <item>
              <attribute name="label" translatable="yes">Demo 2 — English (UK) Northern English Male</attribute>
              <attribute name="action">win.load-demo</attribute>
              <attribute name="target">demo_2</attribute>
            </item>
            <item>
              <attribute name="label" translatable="yes">Demo 3 — English (US) Joe</attribute>
              <attribute name="action">win.load-demo</attribute>
              <attribute name="target">demo_3</attribute>
            </item>
          </submenu>
        </section>
      </submenu>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Minimize Window</attribute>
        <attribute name="action">win.minimize</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Ma_ximize Window</attribute>
        <attribute name="action">win.toggle-maximize</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Toggle Floating Bubble</attribute>
        <attribute name="action">app.toggle-bubble</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Change Logs</attribute>
        <attribute name="action">app.changelog</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About ReadAloud</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
