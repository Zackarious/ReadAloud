<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>im.zackarious.ReadAloud</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ReadAloud</name>
  <summary>Offline Text-to-Speech Reader</summary>

  <description>
    <p>ReadAloud is a modern, privacy-focused text-to-speech desktop application crafted with GTK4 and Libadwaita. Powered by the high-performance Piper neural speech engine, ReadAloud transforms your written text into rich, natural-sounding audio across diverse voices, accents, pitches, and speeds—complete with synchronized word highlighting, seamless playback controls, preset demos, and voice-optimized audio export.</p>
    <p>Unlike conventional cloud-based voice assistants and commercial speech tools, ReadAloud is completely offline. Every syllable is synthesized locally on your own machine using efficient on-device neural models. ReadAloud requires zero internet connection, contains no telemetry, and transmits no data to external servers or third parties. Your personal documents, confidential manuscripts, private notes, and generated recordings remain entirely private, secure, and under your absolute personal control at all times.</p>
    <p>ReadAloud is proud to be free and open-source software, licensed under the GNU General Public License v3.0. There are no subscriptions, no recurring fees, no locked paywalls, and no artificial daily usage limits. Transparent by design, the entire source code is openly audited and maintained by the community on GitHub. Whether you are proofreading drafts, studying long articles, creating audio notes, or enhancing accessibility, ReadAloud offers an ethical, dependable, and always-accessible speech companion that forever puts your personal privacy and freedom first.</p>
  </description>

  <launchable type="desktop-id">im.zackarious.ReadAloud.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <url type="homepage">https://github.com/Zackarious/ReadAloud</url>
  <url type="bugtracker">https://github.com/Zackarious/ReadAloud/issues</url>
  <url type="vcs-browser">https://github.com/Zackarious/ReadAloud</url>

  <content_rating type="oars-1.1"/>

